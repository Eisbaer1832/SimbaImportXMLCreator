import { ComboBox, Palette, Button, VerticalBox, ListView, AboutSlint, LineEdit, HorizontalBox } from "std-widgets.slint";

struct MatchedPattern {
    before: string,
    matched: string,
    after: string,
    partner: bool
}

// In AppState:
export global AppState {
    in-out property <string> csv: "";
    in-out property <string> pdfs: "";
    in-out property <int> current-view: 0;

    in-out property <[MatchedPattern]> csv-names;
    in-out property <[MatchedPattern]> pdf-names;
}

component FileSelect inherits Rectangle  {
    callback request-pdf-dir();
    callback request-csv-file();
    callback get_names();

    VerticalBox {
        padding: 20px;

        Rectangle {
            border-radius: Platform.style-name == "fluent" ? 4px : 2px;
            border-width: Platform.style-name == "fluent" ? 2px : 1px;
            border-color: Palette.border;

            VerticalBox {
            padding: 20px;
                Text {
                    horizontal-alignment: center;
                    height:20px;
                    text: "PDF Ordner: ";
                }
                Text {
                    height:20px;
                    text: AppState.pdfs;
                }
                Button {
                    height:30px;
                    text: "PDF Ordner wählen";
                    clicked => {
                        request-pdf-dir();
                    }
                }
            }
        }

        Rectangle {
            border-radius: Platform.style-name == "fluent" ? 4px : 2px;
            border-width: Platform.style-name == "fluent" ? 2px : 1px;
            border-color: Palette.border;

            VerticalBox {
                padding: 20px;
                Text {
                    horizontal-alignment: center;
                    height:20px;
                    text: "Buchungsstapel: ";
                }
                Text {
                    height:20px;
                    text: AppState.csv;
                }
                Button {
                    height:30px;
                    text: "Buchungsstapel.csv wählen";
                    clicked => {
                        request-csv-file();
                    }
                }
            }
        }

        Rectangle {
            border-radius: Platform.style-name == "fluent" ? 4px : 2px;
            border-width: Platform.style-name == "fluent" ? 2px : 1px;
            border-color: Palette.border;

            VerticalBox {
                padding: 20px;
                Text {
                    height:20px;
                    text: "Mandant: ";
                }
                ComboBox {
                    height:30px;
                    model: ["Option 1", "Option 2", "Option 3"];
                    current-index: 0;
                    selected(value) => {
                    }
                }
            }
        }

        Button {
            height: 30px;
            text: "Weiter";
            clicked => {
                root.get-names();
            }
        }
    }
}


component ChooseNamespace inherits Rectangle {
    callback filter(string);
    callback generate();
    VerticalBox {
        HorizontalBox {

            LineEdit {
                edited(text) => {filter(self.text)}
                horizontal-alignment: TextHorizontalAlignment.center;
                placeholder-text: "Filter";
            }

            Button {
                clicked => {generate()}
                text: "Weiter";
            }
        }

        HorizontalLayout {
            spacing: 10px;
            visible: true;
            accessible-role: AccessibleRole.none;
            alignment: LayoutAlignment.stretch;
            padding: 10px;

            Rectangle {
                border-radius: Platform.style-name == "fluent" ? 4px : 2px;
                border-width: Platform.style-name == "fluent" ? 2px : 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 10px;
                    ListView {
                        accessible-role: AccessibleRole.button;
                        for item in AppState.pdf-names: Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                alignment: LayoutAlignment.center;
                                Text { text: item.before; color: Colors.white; }

                               private property <color> c: item.partner ? Colors.green : Colors.blue;
                                Text { text: item.matched; color: c; font-weight: 700; }
                                Text { text: item.after; color: Colors.white; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: #ccc;
            }
            Rectangle {
                border-radius: Platform.style-name == "fluent" ? 4px : 2px;
                border-width: Platform.style-name == "fluent" ? 2px : 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 10px;
                    ListView  {
                        for item in AppState.csv-names: Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                alignment: LayoutAlignment.center;
                                Text { text: item.before; color: Colors.white; }

                                private property <color> c: item.partner ? Colors.green : Colors.blue;
                                Text { text: item.matched; color: c; font-weight: 700; }
                                Text { text: item.after; color: Colors.white; }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: 200px;
    min-height: 400px;
    min-width: 200px;
    preferred-height: 400px;
    callback request-pdf-dir();
    callback request-csv-file();
    callback generate();
    callback get-names();
    callback filter(string);

    if AppState.current-view == 0: FileSelect {
        request-pdf-dir => { root.request-pdf-dir(); }
        request-csv-file => { root.request-csv-file(); }
        get_names => { root.get-names(); }
    }

    if AppState.current-view == 1: ChooseNamespace{
        filter(text) => { root.filter(text); }
        generate() => {generate()}
    }
}
